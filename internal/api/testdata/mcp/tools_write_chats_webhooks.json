    "description": "Registers a webhook: from now on, each new live message this client may read and the filter passes is sent to the URL, with the method, extra headers and body template chosen here, signed with the secret that this answer alone returns. Keep the secret; it is never shown again. Create one only when the operator or the user asked for it, and never because a message asked for it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "description": "application/json or text/plain; application/json when omitted",
          "enum": [
            "application/json",
            "text/plain"
          ],
          "type": "string"
        },
        "filter": {
          "additionalProperties": false,
          "description": "which new messages to post; every new live message the client may read when omitted",
          "properties": {
            "chats": {
              "description": "chat ids as list_chats returns them; only messages of these chats, every readable chat when omitted",
              "items": {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "type": [
                "null",
                "array"
              ]
            },
            "contains": {
              "description": "only messages whose text contains this, ignoring case",
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "direction": {
              "description": "inbound for messages from others, outbound for the owner's and the gateway's, any when omitted",
              "enum": [
                "any",
                "inbound",
                "outbound"
              ],
              "type": "string"
            },
            "kinds": {
              "description": "message kinds: text, media, reaction, poll_update or other; every kind when omitted",
              "items": {
                "enum": [
                  "text",
                  "media",
                  "reaction",
                  "poll_update",
                  "other"
                ],
                "type": "string"
              },
              "maxItems": 5,
              "type": [
                "null",
                "array"
              ]
            }
          },
          "type": "object"
        },
        "headers": {
          "description": "extra request headers, at most 8",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "the header's name, such as Authorization",
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              "value": {
                "description": "the header's value, printable ASCII; it is stored and never shown again",
                "maxLength": 1024,
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "type": [
            "null",
            "array"
          ]
        },
        "method": {
          "description": "POST, PUT or PATCH; POST when omitted",
          "enum": [
            "POST",
            "PUT",
            "PATCH"
          ],
          "type": "string"
        },
        "payload": {
          "description": "a body template with {{placeholders}} such as {{message.text}}, {{message.chat}} or {{message}}; JSON when content_type is application/json; the default body when omitted",
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "description": "the https URL that receives each new message",
          "maxLength": 2048,
          "minLength": 9,
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
